# ---------------------------------------------------------------------------
# Instagram Sortner - configuration
# Copy to `.env` and edit. Every value below is optional; the defaults are safe.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Bind to loopback only. Do NOT expose this app to the internet: it holds a
# live Instagram session and can take destructive actions on your account.
HOST=127.0.0.1
PORT=4317

# Optional shared secret. When set, the UI asks for it once and every API call
# must carry it (`x-app-token` header). Recommended if HOST is not loopback.
APP_TOKEN=

# --- Storage --------------------------------------------------------------
DATA_DIR=./data

# --- Provider -------------------------------------------------------------
# archive : read-only. Ingests the official "Download your information" export.
#           Zero risk, no credentials, but no unfollow and no live refresh.
# web     : uses your own logged-in session cookies against instagram.com's
#           private web endpoints. Enables live sync + unfollow. See docs/LIMITS.md.
PROVIDER=archive

# Session cookies for PROVIDER=web. Prefer `npm run login` (captures these via a
# real browser window you log into yourself) over pasting them here.
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRFTOKEN=

# --- Dry run ---------------------------------------------------------------
# When true, Unfollow buttons record what *would* happen and send nothing to
# Instagram. Setting it here also LOCKS it on: it cannot be switched off from the
# dashboard, so a stray click can never reach your account. Leave it unset to
# control dry run from Settings instead.
DRY_RUN=

# --- Rate limiting (the settings that keep your account alive) -------------
# Read requests (listing pages, profile enrichment).
READ_MAX_PER_HOUR=180
READ_MIN_GAP_MS=1200

# Write requests (unfollow). These are the dangerous ones. Instagram's own
# informal ceiling for an established account is roughly 150-200 follow/unfollow
# actions per day; staying well under it is the whole game.
UNFOLLOW_MAX_PER_HOUR=15
UNFOLLOW_MAX_PER_DAY=60
# A randomised pause is taken between unfollows, uniform in [MIN, MAX].
UNFOLLOW_MIN_GAP_MS=25000
UNFOLLOW_MAX_GAP_MS=70000

# After this many consecutive failures the queue stops itself and requires a
# manual restart from the UI.
CIRCUIT_BREAKER_FAILURES=3
